{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/gate-check.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/post-edit-check.js"
          },
          {
            "type": "command",
            "command": "node scripts/map-sync.js post-edit",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/andraus-ask-reminder.js",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/andraus-ask-mark.js",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/map-sync.js stop",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node scripts/doc-sync-check.js stop",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "node scripts/handoff-hook.js stop",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/andraus-ask-guard.js",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/map-sync.js stop",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node scripts/doc-sync-check.js stop",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "node scripts/handoff-hook.js stop",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Revisor",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/revisor-guard.js",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/map-sync.js session-start",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node scripts/doc-sync-check.js session-start",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "node scripts/handoff-hook.js session-start",
            "timeout": 30
          }
        ]
      }
    ]
  }
}

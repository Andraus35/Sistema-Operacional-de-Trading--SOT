@@ -0,0 +1,76 @@
+"""Testes da trava 'um PR por vez' (scripts/check_pr_unico.py) — proposta, não instalada."""
+import json
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT / "scripts"))
+import check_pr_unico as c  # noqa: E402
+
+S1 = "ccr-aaaaaaaa-bbbbbb"
+S2 = "ccr-cccccccc-dddddd"
+
+
+def pr(n, ref):
+    return {"number": n, "head": {"ref": ref}}
+
+
+class Trava(unittest.TestCase):
+    def test_u1_mesma_sessao_outro_pr_aberto(self):
+        self.assertEqual(c.conflitos(S1 + "-mapa", 2, [pr(1, S1), pr(2, S1 + "-mapa")]), [(1, S1)])
+
+    def test_u1_pr_mais_antigo_nao_e_travado_pelo_mais_novo(self):
+        self.assertEqual(c.conflitos(S1, 1, [pr(1, S1), pr(2, S1 + "-mapa")]), [])
+
+    def test_u1_entrada_da_api_sem_numero_ou_sem_head_nao_quebra(self):
+        self.assertEqual(c.conflitos(S1, 5, [{"head": {"ref": S1 + "-x"}}, {"number": 1}, {"number": 2, "head": None}]), [])
+
+    def test_u1_sessoes_diferentes_nao_conflitam(self):
+        self.assertEqual(c.conflitos(S1, 2, [pr(1, S2), pr(2, S1)]), [])
+
+    def test_u1_o_proprio_pr_nao_conta(self):
+        self.assertEqual(c.conflitos(S1, 7, [pr(7, S1)]), [])
+
+    def test_u1_sufixo_conta_como_mesma_sessao(self):
+        self.assertEqual(c.conflitos(S1, 3, [pr(1, S1 + "-ledger"), pr(2, S1 + "-mapa"), pr(3, S1)]), [(1, S1 + "-ledger"), (2, S1 + "-mapa")])
+
+    def test_u1_ramo_sem_prefixo_de_sessao_nao_se_aplica(self):
+        self.assertEqual(c.conflitos("claude/x", 2, [pr(1, "claude/y"), pr(2, "claude/x")]), [])
+
+    def test_u2_so_handoff(self):
+        self.assertTrue(c.so_handoff(["handoffs/a.md", "docs/handoffs/HO-1.md"]))
+        self.assertTrue(c.so_handoff(["HANDOFF.md"]))
+
+    def test_u2_handoff_com_trabalho_nao_acusa(self):
+        self.assertFalse(c.so_handoff(["handoffs/a.md", "governance/x.md"]))
+        self.assertFalse(c.so_handoff([]))
+
+    def _roda(self, head, n, prs, files):
+        with tempfile.TemporaryDirectory() as d:
+            d = Path(d)
+            (d / "p.json").write_text(json.dumps(prs), encoding="utf-8")
+            (d / "f.txt").write_text("\n".join(files), encoding="utf-8")
+            return subprocess.run([sys.executable, str(ROOT / "scripts" / "check_pr_unico.py"), "--head", head, "--pr", str(n),
+                                   "--prs-json", str(d / "p.json"), "--files", str(d / "f.txt")], capture_output=True, text=True)
+
+    def test_cli_u1_falha_exit_1(self):
+        r = self._roda(S1 + "-mapa", 2, [pr(1, S1), pr(2, S1 + "-mapa")], ["governance/x.md"])
+        self.assertEqual(r.returncode, 1)
+        self.assertIn("U1", r.stdout)
+
+    def test_cli_u2_so_avisa_exit_0(self):
+        r = self._roda(S1, 1, [pr(1, S1)], ["handoffs/a.md"])
+        self.assertEqual(r.returncode, 0)
+        self.assertIn("U2", r.stdout)
+
+    def test_cli_limpo_exit_0(self):
+        r = self._roda(S1, 1, [pr(1, S1), pr(2, S2)], ["governance/x.md"])
+        self.assertEqual(r.returncode, 0)
+        self.assertNotIn("::warning", r.stdout)
+
+
+if __name__ == "__main__":
+    unittest.main()

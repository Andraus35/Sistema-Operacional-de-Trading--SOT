+#!/usr/bin/env python3
+"""
+check_pr_unico.py — trava determinística "uma frente, um PR aberto por vez" (PROPOSTA DHR-UM-RAMO-UM-PR-001; não instalada).
+
+Roda no CI em eventos de pull_request. Entradas (arquivos JSON/texto vindos da API do GitHub; o script não faz rede):
+  --head REF        ramo de origem do PR atual (github.head_ref)
+  --pr N            número do PR atual
+  --prs-json F      lista de PRs ABERTOS (GET /pulls?state=open): campos number, head.ref
+  --files F         nomes dos arquivos do PR atual, um por linha
+Regras:
+  U1 [FALHA]  existe um PR aberto MAIS ANTIGO cujo ramo tem o mesmo prefixo de sessão ccr-<8 hex>-<6 alfanum>
+              (só o PR mais novo é travado; o mais antigo segue livre, para poder receber push e ser mesclado).
+  U2 [AVISO]  o PR toca SÓ arquivos de handoff (handoffs/, docs/handoffs/, HANDOFF.md): junte ao PR do trabalho.
+Ramo sem prefixo de sessão (ex.: claude/...): U1 não se aplica (sem como agrupar por sessão).
+Exit 1 só em U1. U2 imprime ::warning:: e sai 0. Determinístico: mesma entrada, mesma saída.
+"""
+import argparse
+import json
+import re
+import sys
+
+SESSAO = re.compile(r"^(ccr-[0-9a-f]{8}-[a-z0-9]{6})(?:-.+)?$")
+HANDOFF_PREFIXOS = ("handoffs/", "docs/handoffs/")
+
+
+def chave_sessao(ref):
+    m = SESSAO.match(ref or "")
+    return m.group(1) if m else None
+
+
+def conflitos(head, pr_atual, prs):
+    """Outros PRs abertos da mesma sessão -> [(numero, ramo)]."""
+    k = chave_sessao(head)
+    if not k:
+        return []
+    out = []
+    for p in prs:
+        ref = (p.get("head") or {}).get("ref", "")
+        n = p.get("number")
+        if n is None or n >= pr_atual or ref == head:
+            continue  # só PRs MAIS ANTIGOS bloqueiam: o antigo nunca é travado pelo novo (evita travamento mútuo)
+        if chave_sessao(ref) == k:
+            out.append((p.get("number"), ref))
+    return sorted(out)
+
+
+def so_handoff(arquivos):
+    arq = [a for a in arquivos if a]
+    return bool(arq) and all(a == "HANDOFF.md" or a.startswith(HANDOFF_PREFIXOS) for a in arq)
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description=__doc__.split("\n")[1])
+    ap.add_argument("--head", required=True)
+    ap.add_argument("--pr", type=int, required=True)
+    ap.add_argument("--prs-json", required=True)
+    ap.add_argument("--files", required=True)
+    a = ap.parse_args(argv)
+    with open(a.prs_json, encoding="utf-8") as f:
+        prs = json.load(f)
+    with open(a.files, encoding="utf-8") as f:
+        arquivos = f.read().splitlines()
+    rc = 0
+    c = conflitos(a.head, a.pr, prs)
+    if c:
+        lista = ", ".join(f"#{n} ({r})" for n, r in c)
+        print(f"::error title=Mais de um PR aberto na mesma sessão::U1: {lista}. Regra: uma frente, um PR por vez; mescle ou feche o anterior (e rode o CI de novo).")
+        rc = 1
+    if so_handoff(arquivos):
+        print("::warning title=PR só de handoff::U2: este PR só altera handoffs; junte o handoff ao PR do trabalho (sem PR só para registrar merge).")
+    if rc == 0:
+        print("U1 ok: nenhum outro PR aberto desta sessão.")
+    return rc
+
+
+if __name__ == "__main__":
+    sys.exit(main())
